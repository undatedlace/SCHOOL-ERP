# Copy to deploy/.env.production and fill in. Never commit the real file (it is ignored by git).

POSTGRES_USER=school
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=school_erp

# The address people type, with https. Used to check where requests come from.
APP_ORIGINS=https://school.example.com

# "s3" in production (see docs/s3-setup.md). "local" keeps files in a Docker volume.
FILES_DRIVER=s3
S3_BUCKET=
S3_REGION=ap-south-1
# Leave the two keys empty on AWS to use the server's IAM role.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Port the web container is published on.
WEB_PORT=80
