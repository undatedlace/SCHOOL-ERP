/// A message for one person, shown in the bell and on the Notifications page. Every feature that needs to
/// tell someone something writes one of these through NotificationsService; delivery by e-mail, push or
/// SMS can be added later as channels that read this table without changing the features.
model Notification {
  id        String    @id @default(uuid(7)) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  /// Who it is for.
  userId    String    @map("user_id") @db.Uuid
  /// What happened, like "leave.requested" or "fee.reminder". Lets a channel or a screen decide how to show it.
  type      String
  title     String
  body      String?
  /// Where in the app it takes the person (for example /app/leave).
  link      String?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation("NotificationRecipient", fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}
