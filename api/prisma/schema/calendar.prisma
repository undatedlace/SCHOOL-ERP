enum CalendarCategory {
  EVENT
  HOLIDAY
  EXAM
  MEETING
}

/// A school event, holiday, exam day or meeting. Same audiences as a notice.
/// Archived, never deleted. An event may have announced itself as a notice (notice_id).
model CalendarEvent {
  id          String           @id @default(uuid(7)) @db.Uuid
  schoolId    String           @map("school_id") @db.Uuid
  title       String
  description String?
  category    CalendarCategory @default(EVENT)
  /// First day, and last day (inclusive; the same day for a one-day event).
  startsOn    DateTime         @map("starts_on") @db.Date
  endsOn      DateTime         @map("ends_on") @db.Date
  /// Optional times of day, "HH:MM" (24 hours, India time).
  startTime   String?          @map("start_time")
  endTime     String?          @map("end_time")
  audience    NoticeAudience
  /// The notice sent when the event was created with "tell them", if any.
  noticeId    String?          @unique @map("notice_id") @db.Uuid
  createdById String           @map("created_by_id") @db.Uuid
  archivedAt  DateTime?        @map("archived_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  school    School                @relation(fields: [schoolId], references: [id])
  createdBy User                  @relation("EventAuthor", fields: [createdById], references: [id])
  notice    Notice?               @relation(fields: [noticeId], references: [id])
  targets   CalendarEventTarget[]

  @@index([schoolId, startsOn])
  @@map("calendar_events")
}

model CalendarEventTarget {
  id         String  @id @default(uuid(7)) @db.Uuid
  eventId    String  @map("event_id") @db.Uuid
  classId    String? @map("class_id") @db.Uuid
  divisionId String? @map("division_id") @db.Uuid

  event    CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  class    SchoolClass?  @relation(fields: [classId], references: [id])
  division Division?     @relation(fields: [divisionId], references: [id])

  @@index([eventId])
  @@index([classId])
  @@index([divisionId])
  @@map("calendar_event_targets")
}
