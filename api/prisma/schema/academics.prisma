model AcademicYear {
  id            String    @id @default(uuid(7)) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  name          String
  startDate     DateTime  @map("start_date") @db.Date
  endDate       DateTime  @map("end_date") @db.Date
  isCurrent     Boolean   @default(false) @map("is_current")
  /// Ages are counted as on this date (the paper form's "Age as on"). Empty = the day the form was received.
  ageCutoffDate DateTime? @map("age_cutoff_date") @db.Date

  school          School           @relation(fields: [schoolId], references: [id])
  applications    Application[]
  enrollments     Enrollment[]
  classTeachers   ClassTeacher[]
  subjectTeachers SubjectTeacher[]
  feeStructures   FeeStructure[]
  feeInvoices     FeeInvoice[]
  payments        Payment[]

  @@unique([schoolId, name])
  @@map("academic_years")
}

model SchoolClass {
  id             String  @id @default(uuid(7)) @db.Uuid
  schoolId       String  @map("school_id") @db.Uuid
  name           String
  sortOrder      Int     @map("sort_order")
  /// The youngest age (in whole years) a child may be admitted at. Empty = no age rule.
  minAgeYears    Int?    @map("min_age_years")
  /// Whether the school is taking applications for this class.
  admissionsOpen Boolean @default(true) @map("admissions_open")

  school              School         @relation(fields: [schoolId], references: [id])
  divisions           Division[]
  applications        Application[]  @relation("AppliedClass")
  grantedApplications Application[]  @relation("GrantedClass")
  feeStructures       FeeStructure[]

  @@unique([schoolId, name])
  @@map("classes")
}

model Division {
  id       String @id @default(uuid(7)) @db.Uuid
  schoolId String @map("school_id") @db.Uuid
  classId  String @map("class_id") @db.Uuid
  name     String

  school              School           @relation(fields: [schoolId], references: [id])
  class               SchoolClass      @relation(fields: [classId], references: [id])
  grantedApplications Application[]
  enrollments         Enrollment[]
  classTeachers       ClassTeacher[]
  subjectTeachers     SubjectTeacher[]

  @@unique([classId, name])
  @@index([schoolId])
  @@map("divisions")
}

model Subject {
  id       String  @id @default(uuid(7)) @db.Uuid
  schoolId String  @map("school_id") @db.Uuid
  name     String
  code     String?

  school          School           @relation(fields: [schoolId], references: [id])
  subjectTeachers SubjectTeacher[]

  @@unique([schoolId, name])
  @@map("subjects")
}
