enum SchoolStatus {
  ACTIVE
  /// Nobody in the school can sign in (set by the platform owner); everything is kept.
  SUSPENDED
}

model School {
  id                 String       @id @default(uuid(7)) @db.Uuid
  name               String
  /// Typed at sign-in when the system holds more than one school, for example "hesj". Lower case.
  code               String       @unique
  status             SchoolStatus @default(ACTIVE)
  address            String?
  phone              String?
  email              String?
  board              String?
  /// Student IDs are this prefix plus a zero-padded number, for example hesj0001. Empty = plain numbers.
  studentIdPrefix    String?      @map("student_id_prefix")
  studentIdDigits    Int          @default(4) @map("student_id_digits")
  /// With a domain, a student's school e-mail is their ID at this domain.
  studentEmailDomain String?      @map("student_email_domain")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @default(now()) @updatedAt @map("updated_at")

  users                User[]
  sessions             Session[]
  academicYears        AcademicYear[]
  classes              SchoolClass[]
  divisions            Division[]
  subjects             Subject[]
  auditLogs            AuditLog[]
  forms                FormDefinition[]
  applications         Application[]
  files                StoredFile[]
  students             Student[]
  attendance           AttendanceRecord[]
  notices              Notice[]
  calendarEvents       CalendarEvent[]
  staffTypes           StaffType[]
  notifications        Notification[]
  devices              Device[]
  homework             Homework[]
  assessments          Assessment[]
  leaveTypes           LeaveType[]
  leaveEntitlements    LeaveEntitlement[]
  leaveRequests        LeaveRequest[]
  staffAttendance      StaffAttendanceRecord[]
  guardians            Guardian[]
  enrollments          Enrollment[]
  staff                Staff[]
  classTeachers        ClassTeacher[]
  subjectTeachers      SubjectTeacher[]
  feeHeads             FeeHead[]
  feeStructures        FeeStructure[]
  feeInvoices          FeeInvoice[]
  payments             Payment[]
  importBatches        ImportBatch[]
  bellSchedules        BellSchedule[]
  bellSlots            BellSlot[]
  classBellSchedules   ClassBellSchedule[]
  timetableEntries     TimetableEntry[]
  timetableAdjustments TimetableAdjustment[]

  @@map("schools")
}
