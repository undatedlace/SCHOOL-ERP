enum InvoiceKind {
  /// Made from a class's fee structure for one academic year.
  FEE_STRUCTURE
  /// Dues brought over from before the system, or from a previous year.
  OPENING_BALANCE
}

enum PaymentMode {
  CASH
  CHEQUE
  UPI
  BANK_TRANSFER
  /// Reserved for the online payment gateway, which is on hold.
  ONLINE
}

/// One kind of charge: tuition, exam fee, and so on. Never deleted, only switched off.
model FeeHead {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  school       School             @relation(fields: [schoolId], references: [id])
  items        FeeStructureItem[]
  invoiceLines FeeInvoiceLine[]

  @@unique([schoolId, name])
  @@map("fee_heads")
}

/// What a class is charged in one academic year, and when it is due. A template:
/// changing it never changes invoices that were already made from it.
model FeeStructure {
  id             String   @id @default(uuid(7)) @db.Uuid
  schoolId       String   @map("school_id") @db.Uuid
  academicYearId String   @map("academic_year_id") @db.Uuid
  classId        String   @map("class_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  school       School                   @relation(fields: [schoolId], references: [id])
  academicYear AcademicYear             @relation(fields: [academicYearId], references: [id])
  class        SchoolClass              @relation(fields: [classId], references: [id])
  items        FeeStructureItem[]
  instalments  FeeStructureInstalment[]
  invoices     FeeInvoice[]

  @@unique([academicYearId, classId])
  @@index([schoolId])
  @@map("fee_structures")
}

model FeeStructureItem {
  id          String  @id @default(uuid(7)) @db.Uuid
  structureId String  @map("structure_id") @db.Uuid
  feeHeadId   String  @map("fee_head_id") @db.Uuid
  amount      Decimal @db.Decimal(12, 2)

  structure FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  feeHead   FeeHead      @relation(fields: [feeHeadId], references: [id])

  @@unique([structureId, feeHeadId])
  @@map("fee_structure_items")
}

/// One due date of the plan. `percentBp` is the share of the total in basis points (10000 = 100%).
model FeeStructureInstalment {
  id          String   @id @default(uuid(7)) @db.Uuid
  structureId String   @map("structure_id") @db.Uuid
  seq         Int
  label       String
  dueDate     DateTime @map("due_date") @db.Date
  percentBp   Int      @map("percent_bp")

  structure FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  @@unique([structureId, seq])
  @@map("fee_structure_instalments")
}

/// What one student owes for one academic year. Lines and instalments are copies made when the
/// invoice was created. The balance is never stored: it is worked out from the rows.
model FeeInvoice {
  id             String      @id @default(uuid(7)) @db.Uuid
  schoolId       String      @map("school_id") @db.Uuid
  studentId      String      @map("student_id") @db.Uuid
  academicYearId String      @map("academic_year_id") @db.Uuid
  kind           InvoiceKind
  structureId    String?     @map("structure_id") @db.Uuid
  note           String?
  createdById    String      @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")

  school       School              @relation(fields: [schoolId], references: [id])
  student      Student             @relation(fields: [studentId], references: [id])
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id])
  structure    FeeStructure?       @relation(fields: [structureId], references: [id])
  lines        FeeInvoiceLine[]
  instalments  FeeInstalment[]
  concessions  Concession[]
  allocations  PaymentAllocation[]

  @@unique([studentId, academicYearId, kind])
  @@index([schoolId, academicYearId])
  @@map("fee_invoices")
}

model FeeInvoiceLine {
  id          String  @id @default(uuid(7)) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  feeHeadId   String? @map("fee_head_id") @db.Uuid
  description String
  amount      Decimal @db.Decimal(12, 2)

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeHead FeeHead?   @relation(fields: [feeHeadId], references: [id])

  @@index([invoiceId])
  @@map("fee_invoice_lines")
}

/// A due date on an invoice, before any concession. What is really asked for at each date is
/// worked out from the concessions (see ledger.ts), so it can never disagree with them.
model FeeInstalment {
  id        String   @id @default(uuid(7)) @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  seq       Int
  label     String
  dueDate   DateTime @map("due_date") @db.Date
  amount    Decimal  @db.Decimal(12, 2)

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, seq])
  @@map("fee_instalments")
}

/// A discount. Never deleted: taking one back records who and why.
model Concession {
  id            String    @id @default(uuid(7)) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  invoiceId     String    @map("invoice_id") @db.Uuid
  amount        Decimal   @db.Decimal(12, 2)
  reason        String
  createdById   String    @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedById   String?   @map("revoked_by_id") @db.Uuid
  revokedReason String?   @map("revoked_reason")

  invoice FeeInvoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@map("concessions")
}

/// Money received. Append-only: a mistake is corrected with a reversal, never by editing or deleting.
model Payment {
  id             String      @id @default(uuid(7)) @db.Uuid
  schoolId       String      @map("school_id") @db.Uuid
  studentId      String      @map("student_id") @db.Uuid
  /// The academic year whose receipt series this belongs to (the current year when it was taken).
  academicYearId String      @map("academic_year_id") @db.Uuid
  receiptSeq     Int         @map("receipt_seq")
  amount         Decimal     @db.Decimal(12, 2)
  mode           PaymentMode
  /// Cheque number, UPI reference, or bank transaction id.
  reference      String?
  bank           String?
  paidOn         DateTime    @map("paid_on") @db.Date
  note           String?
  receivedById   String      @map("received_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at")

  school       School              @relation(fields: [schoolId], references: [id])
  student      Student             @relation(fields: [studentId], references: [id])
  academicYear AcademicYear        @relation(fields: [academicYearId], references: [id])
  allocations  PaymentAllocation[]
  reversal     PaymentReversal?

  @@unique([schoolId, academicYearId, receiptSeq])
  @@index([schoolId, paidOn])
  @@index([studentId])
  @@map("payments")
}

model PaymentAllocation {
  id        String  @id @default(uuid(7)) @db.Uuid
  paymentId String  @map("payment_id") @db.Uuid
  invoiceId String  @map("invoice_id") @db.Uuid
  amount    Decimal @db.Decimal(12, 2)

  payment Payment    @relation(fields: [paymentId], references: [id])
  invoice FeeInvoice @relation(fields: [invoiceId], references: [id])

  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

/// Cancels a whole payment (a bounced cheque, a wrong entry). The reason is required.
model PaymentReversal {
  id           String   @id @default(uuid(7)) @db.Uuid
  paymentId    String   @unique @map("payment_id") @db.Uuid
  reason       String
  reversedById String   @map("reversed_by_id") @db.Uuid
  reversedOn   DateTime @map("reversed_on") @db.Date
  createdAt    DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("payment_reversals")
}
