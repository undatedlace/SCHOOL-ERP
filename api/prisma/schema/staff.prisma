enum StaffStatus {
  ACTIVE
  LEFT
}

/// A member of staff. Never hard-deleted: leaving sets status and left_on, so joining
/// and leaving counts per year stay correct. A login account is optional (user_id).
model Staff {
  id            String      @id @default(uuid(7)) @db.Uuid
  schoolId      String      @map("school_id") @db.Uuid
  /// Counts 1, 2, 3 ... within a school, assigned by the server.
  seq           Int
  /// What the school calls the employee number (defaults to the sequence number).
  employeeNo    String      @map("employee_no")
  firstName     String      @map("first_name")
  surname       String
  gender        Gender
  dateOfBirth   DateTime?   @map("date_of_birth") @db.Date
  mobile        String?
  email         String?
  /// For example "Teacher", "Clerk", "Peon".
  designation   String
  qualification String?
  address       String?
  photoFileId   String?     @map("photo_file_id") @db.Uuid
  status        StaffStatus @default(ACTIVE)
  joinedOn      DateTime    @map("joined_on") @db.Date
  leftOn        DateTime?   @map("left_on") @db.Date
  /// The login account. Set when the school gives this person access.
  userId        String?     @unique @map("user_id") @db.Uuid
  /// What kind of employee (teacher, clerk, peon...), which decides the onboarding form.
  staffTypeId   String?     @map("staff_type_id") @db.Uuid
  /// The version of that type's form the answers were filled in with.
  formId        String?     @map("form_id") @db.Uuid
  /// { [fieldId]: value }, checked against that form version. Documents are stored as file ids.
  answers       Json?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  school         School                  @relation(fields: [schoolId], references: [id])
  user           User?                   @relation(fields: [userId], references: [id])
  staffType      StaffType?              @relation(fields: [staffTypeId], references: [id])
  classTeacherOf ClassTeacher[]
  subjectsTaught SubjectTeacher[]
  attendance     StaffAttendanceRecord[]

  @@unique([schoolId, seq])
  @@unique([schoolId, employeeNo])
  @@index([schoolId, status])
  @@index([schoolId, surname, firstName])
  @@map("staff")
}

/// A kind of employee the school has, such as Teacher, Clerk or Peon. Each has its own onboarding form
/// (form key `staff-<id>`). Types are switched off, never deleted.
model StaffType {
  id         String   @id @default(uuid(7)) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  name       String
  /// Teaching staff can be given classes and subjects; the starting form differs too.
  isTeaching Boolean  @default(false) @map("is_teaching")
  active     Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  school School  @relation(fields: [schoolId], references: [id])
  staff  Staff[]

  @@unique([schoolId, name])
  @@map("staff_types")
}
