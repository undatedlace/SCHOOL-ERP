enum UserStatus {
  ACTIVE
  DISABLED
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  schoolId           String     @map("school_id") @db.Uuid
  fullName           String     @map("full_name")
  email              String?
  mobile             String?
  /// A sign-in name for people with no email or mobile number of their own: a student signs in with their admission number.
  username           String?
  passwordHash       String     @map("password_hash")
  mustChangePassword Boolean    @default(true) @map("must_change_password")
  status             UserStatus @default(ACTIVE)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  school           School             @relation(fields: [schoolId], references: [id])
  roles            UserRole[]
  sessions         Session[]
  attendanceMarked AttendanceRecord[] @relation("AttendanceMarker")
  /// A shared phone gives two guardians (father and mother) one login.
  guardians        Guardian[]
  student          Student?
  staff            Staff?

  @@unique([schoolId, email])
  @@unique([schoolId, mobile])
  @@unique([schoolId, username])
  @@index([schoolId])
  @@map("users")
}

model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School @relation(fields: [schoolId], references: [id])

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
