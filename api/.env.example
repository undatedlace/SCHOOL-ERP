DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/school_erp?schema=public"
APP_ORIGINS="http://localhost:4200"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
# Set to "true" when running behind nginx so the real client IP is recorded
TRUST_PROXY="false"

# Used only by `npm run test:e2e`. The name must end in _test (tests wipe this database).
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/school_erp_test?schema=public"

# ---- File storage ----
# "local" keeps files on this machine (FILES_DIR). "s3" uses an S3-compatible bucket.
# After filling in the S3_* values, run `npm run s3:check` to test them.
FILES_DRIVER="local"
# S3_BUCKET=""
# S3_REGION="ap-south-1"
# Leave both keys empty on AWS to use the server's IAM role.
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# Only for non-AWS services (Cloudflare R2, MinIO...):
# S3_ENDPOINT=""
# S3_FORCE_PATH_STYLE="true"
# Optional folder inside the bucket:
# S3_KEY_PREFIX="school-erp"

# ---- Reading paper admission forms from photos (ocr-service/) ----
# Leave empty to hide "Fill from photos". Locally: http://127.0.0.1:8001
# OCR_SERVICE_URL=""
# Must match the service's OCR_SERVICE_TOKEN when it sets one.
# OCR_SERVICE_TOKEN=""
