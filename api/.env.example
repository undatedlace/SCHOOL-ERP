DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/school_erp?schema=public"
APP_ORIGINS="http://localhost:4200"
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-before-seeding"
# Set to "true" when running behind nginx so the real client IP is recorded
TRUST_PROXY="false"

# Used only by `npm run test:e2e`. The name must end in _test (tests wipe this database).
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/school_erp_test?schema=public"
